# secrets — never commit
.env
secrets/*.pem
secrets/*.key
secrets/*.txt

# runtime state + learning log artifacts (keep the dir, ignore contents)
data/*.json
data/*.jsonl
data/*.sqlite
data/*.sqlite-*
data/historical_cache/
!data/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# operating system
.DS_Store

# cron literal-variable workaround symlink
$REPO

# monitor runtime state (per-install; not source)
data/monitor.md
data/monitor_snapshot.json
data/monitor_gist_id.txt
data/monitor_delivery_health.json
data/monitor_alert_state.json
