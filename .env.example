# ─── Kalshi (NEW API key) ────────────────────────────────────────────────────
# Create a fresh key pair at https://kalshi.com → Settings → API. Put the key id
# here and the downloaded RSA private key at the path below. NEVER commit the .pem.
KALSHI_API_KEY=REPLACE_WITH_NEW_KEY_ID
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-private-key.pem
KALSHI_API_BASE=https://api.elections.kalshi.com

# ─── Bot ─────────────────────────────────────────────────────────────────────
# Which game config to load: config/<GAME_ID>.game.yaml + <GAME_ID>.scenarios.yaml
NBABOT_GAME_ID=NBA-2026-FINALS-G3

# Where alerts go: "stdout", "telegram", "telegram:<chat_id>", or an incoming-webhook URL.
NBABOT_DELIVER_TO=stdout
NBABOT_TELEGRAM_BOT_TOKEN=
NBABOT_TELEGRAM_CHAT_ID=

# ─── External source feeds ────────────────────────────────────────────────────
# Primary structured odds/event feed for slate discovery + line movement.
SPORTSGAMEODDS_API_KEY=

# Secondary structured odds feed for consensus backup + cross-checking.
THE_ODDS_API_KEY=

# Optional opinion/social feeds for research context only. These must never be the
# sole reason to execute an order.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=kalshi-sports-orderbook/1.0
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Source health probes are disabled by default so routine status checks do not
# spend quota. Set to 1 when you deliberately want `ksobot source-check` to call
# provider endpoints.
NBABOT_SOURCE_CHECK_NETWORK=0

# Safety. 1 = never place orders (monitor-only, the default and intended mode).
# This bot REPORTS which game-script is becoming true; it does not chase bets.
NBABOT_DRY_RUN=1

# Where runtime state + the learning log are written
NBABOT_DATA_DIR=./data

# Conservative learned calibration overrides. Reconcile writes this; load_context reads it.
NBABOT_CALIBRATION_OVERRIDES=./data/calibration_overrides.json

# Paper is local-only. Demo uses the Kalshi demo API. Live submits real-money orders
# only when all three live gates below are set deliberately.
NBABOT_EXECUTION_MODE=paper
NBABOT_LIVE_TRADING_ACK=
# Optional minimum-edge override. This never bypasses any other risk check and
# requires per-intent rationale, sources, named approval, and stake <=1u.
NBABOT_RESEARCH_OVERRIDE_ACK=
NBABOT_RESEARCH_OVERRIDE_MAX_UNITS=1
NBABOT_MAX_DAILY_LOSS_UNITS=2
NBABOT_MAX_GAME_EXPOSURE_UNITS=5
NBABOT_MIN_EDGE=0.05
NBABOT_STALE_MARKET_SECONDS=90
NBABOT_MAX_SPREAD_CENTS=10
NBABOT_KILL_SWITCH=./data/KILL_SWITCH

# Order book snapshots used by `nbabot book-watch`.
NBABOT_ORDERBOOK_DEPTH=
NBABOT_BOOK_WATCH_ITERATIONS=1
NBABOT_BOOK_WATCH_INTERVAL_SECONDS=0
